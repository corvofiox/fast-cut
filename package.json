{
  "name": "fast-cut",
  "version": "0.1.0",
  "private": true,
  "description": "Fast Cut - 快速启动、快速粗剪、快速导出的极简视频裁剪工具（流拷贝为核心）",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "core:test": "node --test \"core/*.test.js\"",
    "core:demo": "node core/demo.js",
    "core:codecs": "node scripts/codecs.js",
    "smoke": "electron scripts/smoke.js",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "cn.fastcut.desktop",
    "productName": "Fast Cut",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "core/**/*",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*.exe"]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Fast-Cut-Setup-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Fast Cut"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  }
}
